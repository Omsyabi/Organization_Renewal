<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OrgPort | Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }

        :root {
            --pink: #ff3cac;
            --purple: #a855f7;
            --dark: #130b20;
            --panel: #20132e;
            --border: rgba(255,255,255,0.09);
            --muted: #b8a8c9;
            --white: #fff8ff;
        }

        body {
            background: var(--dark);
            color: var(--white);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.2;
            pointer-events: none;
            z-index: -1;
        }

        body::before {
            background: var(--pink);
            top: -150px;
            right: 10%;
        }

        body::after {
            background: var(--purple);
            bottom: -150px;
            left: 20%;
        }

        /* SIDEBAR */
        .sidebar {
            width: 255px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 28px 18px;
            background: rgba(25,14,37,0.96);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 5px 8px;
            margin-bottom: 45px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            box-shadow: 0 0 22px rgba(255,60,172,0.25);
            font-size: 23px;
        }

        .logo-text {
            font-family: 'Outfit', sans-serif;
            font-size: 21px;
            font-weight: 900;
        }

        .logo-text span {
            color: #ff70c5;
        }

        .logo-subtitle {
            color: #9582a9;
            font-size: 10px;
            margin-top: 3px;
            letter-spacing: 1px;
        }

        .menu-label {
            color: #806b95;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            padding: 0 13px;
            margin-bottom: 15px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px 15px;
            margin-bottom: 8px;
            color: var(--muted);
            text-decoration: none;
            border: 1px solid transparent;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s;
        }

        .nav-icon {
            width: 23px;
            text-align: center;
            font-size: 17px;
        }

        .sidebar a:hover {
            color: white;
            background: rgba(255,60,172,0.08);
            border-color: rgba(255,60,172,0.15);
            transform: translateX(3px);
        }

        .sidebar a.active {
            color: white;
            background: linear-gradient(100deg,
                rgba(255,60,172,0.19),
                rgba(139,92,246,0.12));
            border-color: rgba(255,60,172,0.3);
            box-shadow: inset 3px 0 var(--pink);
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .sidebar-tip {
            background: linear-gradient(135deg,
                rgba(255,60,172,0.12),
                rgba(139,92,246,0.12));
            border: 1px solid rgba(255,60,172,0.17);
            border-radius: 15px;
            padding: 17px;
            margin-bottom: 20px;
        }

        .tip-icon {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .sidebar-tip h4 {
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .sidebar-tip p {
            color: var(--muted);
            font-size: 11px;
            line-height: 1.7;
        }

        .logout {
            color: #ff82bd !important;
            border: 1px solid rgba(255,60,172,0.15) !important;
        }

        .logout:hover {
            background: rgba(255,60,172,0.12) !important;
        }

        /* MAIN AREA */
        .main-area {
            margin-left: 255px;
            min-height: 100vh;
        }

        .topbar {
            min-height: 82px;
            padding: 18px 38px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            background: rgba(19,11,32,0.7);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }

        .breadcrumb {
            color: #927da7;
            font-size: 12px;
        }

        .breadcrumb span {
            color: #ff70c5;
            font-weight: 700;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            font-size: 20px;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 800;
        }

        .profile-role {
            color: #a18cad;
            font-size: 10px;
            margin-top: 4px;
        }

        /* CONTENT */
        .main {
            padding: 38px;
            max-width: 1600px;
            margin: auto;
        }

        .welcome-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 35px;
        }

        .welcome-tag {
            color: #ff70c5;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2.5px;
            margin-bottom: 13px;
        }

        .welcome-section h1 {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(28px, 3vw, 39px);
            font-weight: 900;
            letter-spacing: -1.2px;
            margin-bottom: 10px;
        }

        .welcome-section h1 span {
            background: linear-gradient(90deg, var(--pink), #c4b5fd);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .year-badge {
            padding: 12px 16px;
            background: rgba(255,60,172,0.08);
            border: 1px solid rgba(255,60,172,0.2);
            color: #ff9bd5;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        /* ORGANIZATION SECTION */
        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .section-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 22px;
            font-weight: 800;
        }

        .section-heading p {
            color: #a18cad;
            font-size: 11px;
            margin-top: 6px;
        }

        .section-label {
            color: #ff70c5;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .org-container {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .org-card {
            padding: 24px;
            background: linear-gradient(145deg,
                rgba(42,27,59,0.96),
                rgba(29,17,43,0.96));
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.3s;
            position: relative;
            overflow: hidden;
        }

        .org-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,60,172,0.35);
            box-shadow: 0 12px 35px rgba(0,0,0,0.2);
        }

        .org-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--pink), var(--purple));
            opacity: 0;
            transition: 0.3s;
        }

        .org-card:hover::before {
            opacity: 1;
        }

        .org-header {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 22px;
        }

        .org-identity {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .org-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            font-size: 24px;
            background: rgba(255,60,172,0.12);
            border: 1px solid rgba(255,60,172,0.16);
        }

        .org-name {
            font-family: 'Outfit', sans-serif;
            font-size: 16px;
            font-weight: 800;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .org-type {
            color: #a18cad;
            font-size: 11px;
            margin-top: 6px;
        }

        .org-divider {
            height: 1px;
            background: var(--border);
            margin-bottom: 18px;
        }

        .org-description {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .org-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .org-year {
            color: #a18cad;
            font-size: 11px;
        }

        .view-btn {
            display: inline-block;
            padding: 10px 15px;
            color: white;
            background: linear-gradient(100deg, var(--pink), var(--purple));
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
            transition: 0.25s;
            white-space: nowrap;
        }

        .view-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 18px rgba(255,60,172,0.25);
        }

        footer {
            color: #806b95;
            text-align: center;
            font-size: 11px;
            margin-top: 40px;
            padding-bottom: 10px;
        }

        
/* CLICKABLE PROFILE BUTTON */
.profile-button {
    border: 1px solid transparent;
    background: transparent;
    color: var(--white);
    font: inherit;
    cursor: pointer;
    padding: 7px 10px;
    border-radius: 14px;
    transition: 0.25s;
    text-align: left;
}

.profile-button:hover {
    background: rgba(255, 60, 172, 0.10);
    border-color: rgba(255, 60, 172, 0.2);
}

.profile-arrow {
    color: #ff70c5;
    font-size: 18px;
    margin-left: 8px;
}

/* DARK OVERLAY */
.profile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 2, 12, 0.65);
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
    z-index: 200;
}

.profile-overlay.show {
    opacity: 1;
    visibility: visible;
}

/* RIGHT PROFILE SIDEBAR */
.profile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 360px;
    max-width: 90%;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    padding: 28px;
    background: #1b1028;
    border-left: 1px solid var(--border);
    box-shadow: -15px 0 50px rgba(0, 0, 0, 0.35);
    z-index: 201;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0.3s;
}

.profile-drawer.show {
    transform: translateX(0);
    visibility: visible;
}

.drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
}

.drawer-header h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 21px;
}

.drawer-close {
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--panel);
    color: white;
    font-size: 22px;
    cursor: pointer;
}

.drawer-close:hover {
    background: rgba(255, 60, 172, 0.15);
}

.drawer-user {
    text-align: center;
    padding: 25px 15px;
    border: 1px solid rgba(255, 60, 172, 0.18);
    border-radius: 18px;
    background: linear-gradient(
        145deg,
        rgba(255, 60, 172, 0.12),
        rgba(139, 92, 246, 0.12)
    );
    margin-bottom: 30px;
}

.drawer-avatar {
    width: 75px;
    height: 75px;
    margin: 0 auto 15px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 22px;
    background: linear-gradient(135deg, var(--pink), var(--purple));
    font-size: 34px;
    box-shadow: 0 0 25px rgba(255, 60, 172, 0.2);
}

.drawer-user h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 19px;
    margin-bottom: 7px;
}

.drawer-user p {
    color: var(--muted);
    font-size: 12px;
    overflow-wrap: anywhere;
    line-height: 1.7;
}

.drawer-label {
    color: #ff70c5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.8px;
    margin-bottom: 15px;
}

.profile-info {
    padding: 17px;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.025);
}

.profile-info-label {
    color: #a18cad;
    font-size: 11px;
    margin-bottom: 8px;
}

.profile-info-value {
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    overflow-wrap: anywhere;
    line-height: 1.6;
}

.drawer-logout {
    display: block;
    margin-top: 25px;
    padding: 14px;
    text-align: center;
    text-decoration: none;
    color: #ff82bd;
    background: rgba(255, 60, 172, 0.08);
    border: 1px solid rgba(255, 60, 172, 0.2);
    border-radius: 12px;
    font-size: 13px;
    font-weight: 700;
    transition: 0.25s;
}

.drawer-logout:hover {
    background: rgba(255, 60, 172, 0.16);
}

/* MOBILE */
@media (max-width: 480px) {
    .profile-drawer {
        padding: 22px;
    }

    .profile-summary {
        display: block;
    }
}


        /* RESPONSIVE */
        @media (max-width: 1100px) {
            .org-container {
                grid-template-columns: 1fr;
            }

            .main {
                padding: 28px;
            }

            .topbar {
                padding: 18px 28px;
            }
        }

        @media (max-width: 760px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 18px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu-label,
            .sidebar-tip {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .sidebar nav a {
                margin: 0;
                flex: 1 1 140px;
            }

            .sidebar-bottom {
                margin-top: 10px;
            }

            .main-area {
                margin-left: 0;
            }

            .topbar {
                padding: 16px 20px;
            }

            .main {
                padding: 25px 18px;
            }

            .welcome-section {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .profile-name,
            .profile-role {
                display: none;
            }

            .org-card {
                padding: 18px;
            }

            .org-footer {
                align-items: flex-start;
                flex-direction: column;
            }

            .year-badge {
                white-space: normal;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="logo">
            <div class="logo-icon">✦</div>
            <div>
                <div class="logo-text">ORG<span>PORT</span></div>
                <div class="logo-subtitle">ORGANIZATION PORTAL</div>
            </div>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <nav>
            <a href="/dashboard?email=<%= encodeURIComponent(email) %>">
                <span>⌂</span>Dashboard
            </a>
            
            <a href="/renewal?email=<%= encodeURIComponent(email) %>">
                <span>✧</span>Organization Renewal
            </a>
            
            <a href="/status?email=<%= encodeURIComponent(email) %>">
                <span>◷</span>Renewal Status
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-tip">
                <div class="tip-icon">💖</div>
                <h4>You've got this!</h4>
                <p>Keep your organization information updated and your renewal documents ready.</p>
            </div>

            
        </div>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <div class="breadcrumb">
                Pages / <span>Dashboard</span>
            </div>

            
            <button type="button" class="profile profile-button" id="profileToggle"
            aria-label="Open profile" aria-expanded="false">
            <div class="profile-avatar">👑</div>
            <div class="profile-summary">
            <div class="profile-name">My Account</div>
            <div class="profile-role">View Profile</div>
            </div>
<span class="profile-arrow">⌄</span>
</button>

        </header>

        <main class="main">

            <section class="welcome-section">
                <div>
                    <div class="welcome-tag">✦ YOUR ORGANIZATION SPACE</div>
                    <h1>Welcome to <span>OrgPort!</span></h1>
                    <p class="subtitle">
                        Manage your organization and keep your renewal requirements on track.
                    </p>
                </div>

                <div class="year-badge">
                    ✦ SCHOOL YEAR 2026–2027
                </div>
            </section>

            <section class="organizations">
                <div class="section-heading">
                    <div>
                        <h2>Your Organizations</h2>
                        <p>Explore your organizations and their renewal information.</p>
                    </div>

                    <div class="section-label">ORGANIZATION LIST</div>
                </div>

                <div class="org-container">

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">✦</div>
                                <div>
                                    <div class="org-name">XCite</div>
                                    <div class="org-type">Dance Organization</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            View XCite's organization details and review the requirements
                            for the current school year's renewal.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/xcite?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">♛</div>
                                <div>
                                    <div class="org-name">Cite Student Council</div>
                                    <div class="org-type">Leadership</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            Explore the Student Council's organization details and
                            its renewal requirements.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/cite-student-council?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">⌘</div>
                                <div>
                                    <div class="org-name">CITE Multimedia Arts Studio</div>
                                    <div class="org-type">Multimedia Arts</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            Check the Multimedia Arts Studio's details and prepare
                            the required renewal documents.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/cite-multimedia-arts-studio?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">⌨</div>
                                <div>
                                    <div class="org-name">F1 Stack Mind</div>
                                    <div class="org-type">Technology</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            View F1 Stack Mind's organization information and
                            review its renewal requirements.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/f1?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                </div>
            </section>

            <footer>
                © 2026 OrgPort · Lead boldly. Renew confidently.
            </footer>

        </main>
    </div>

    
<!-- PROFILE OVERLAY -->
<div class="profile-overlay" id="profileOverlay"></div>

<!-- PROFILE SIDEBAR -->
<aside class="profile-drawer" id="profileDrawer"
       aria-label="User profile" aria-hidden="true">

    <div class="drawer-header">
        <h2>My Profile</h2>
        <button type="button" class="drawer-close" id="profileClose"
                aria-label="Close profile">&times;</button>
    </div>

    <div class="drawer-user">
        <div class="drawer-avatar">👑</div>
        <h3>Organization Member</h3>
        <p>Your OrgPort account</p>
    </div>

    <div class="drawer-label">ACCOUNT INFORMATION</div>

    <div class="profile-info">
        <div class="profile-info-label">Email Address</div>
        <div class="profile-info-value"><%= email %></div>
    </div>

    <div class="profile-info">
        <div class="profile-info-label">Account Type</div>
        <div class="profile-info-value">Organization Member</div>
    </div>

    <div class="profile-info">
        <div class="profile-info-label">School Year</div>
        <div class="profile-info-value">2026–2027</div>
    </div>

    <a href="/logout" class="drawer-logout">↪ Log Out</a>

</aside>

<script>
    const profileToggle = document.getElementById('profileToggle');
    const profileDrawer = document.getElementById('profileDrawer');
    const profileOverlay = document.getElementById('profileOverlay');
    const profileClose = document.getElementById('profileClose');

    function openProfile() {
        profileDrawer.classList.add('show');
        profileOverlay.classList.add('show');
        profileDrawer.setAttribute('aria-hidden', 'false');
        profileToggle.setAttribute('aria-expanded', 'true');
    }

    function closeProfile() {
        profileDrawer.classList.remove('show');
        profileOverlay.classList.remove('show');
        profileDrawer.setAttribute('aria-hidden', 'true');
        profileToggle.setAttribute('aria-expanded', 'false');
    }

    profileToggle.addEventListener('click', openProfile);
    profileClose.addEventListener('click', closeProfile);
    profileOverlay.addEventListener('click', closeProfile);

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            closeProfile();
        }
    });
</script>
</body>
</html>


