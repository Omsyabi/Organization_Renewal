<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OrgPort | Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }

        :root {
            --pink: #ff3cac;
            --purple: #a855f7;
            --dark: #130b20;
            --panel: #20132e;
            --border: rgba(255,255,255,0.09);
            --muted: #b8a8c9;
            --white: #fff8ff;
        }

        body {
            background: var(--dark);
            color: var(--white);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.2;
            pointer-events: none;
            z-index: -1;
        }

        body::before {
            background: var(--pink);
            top: -150px;
            right: 10%;
        }

        body::after {
            background: var(--purple);
            bottom: -150px;
            left: 20%;
        }

        /* SIDEBAR */
        .sidebar {
            width: 255px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 28px 18px;
            background: rgba(25,14,37,0.96);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 5px 8px;
            margin-bottom: 45px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            box-shadow: 0 0 22px rgba(255,60,172,0.25);
            font-size: 23px;
        }

        .logo-text {
            font-family: 'Outfit', sans-serif;
            font-size: 21px;
            font-weight: 900;
        }

        .logo-text span {
            color: #ff70c5;
        }

        .logo-subtitle {
            color: #9582a9;
            font-size: 10px;
            margin-top: 3px;
            letter-spacing: 1px;
        }

        .menu-label {
            color: #806b95;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            padding: 0 13px;
            margin-bottom: 15px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px 15px;
            margin-bottom: 8px;
            color: var(--muted);
            text-decoration: none;
            border: 1px solid transparent;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s;
        }

        .nav-icon {
            width: 23px;
            text-align: center;
            font-size: 17px;
        }

        .sidebar a:hover {
            color: white;
            background: rgba(255,60,172,0.08);
            border-color: rgba(255,60,172,0.15);
            transform: translateX(3px);
        }

        .sidebar a.active {
            color: white;
            background: linear-gradient(100deg,
                rgba(255,60,172,0.19),
                rgba(139,92,246,0.12));
            border-color: rgba(255,60,172,0.3);
            box-shadow: inset 3px 0 var(--pink);
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .sidebar-tip {
            background: linear-gradient(135deg,
                rgba(255,60,172,0.12),
                rgba(139,92,246,0.12));
            border: 1px solid rgba(255,60,172,0.17);
            border-radius: 15px;
            padding: 17px;
            margin-bottom: 20px;
        }

        .tip-icon {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .sidebar-tip h4 {
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .sidebar-tip p {
            color: var(--muted);
            font-size: 11px;
            line-height: 1.7;
        }

        .logout {
            color: #ff82bd !important;
            border: 1px solid rgba(255,60,172,0.15) !important;
        }

        .logout:hover {
            background: rgba(255,60,172,0.12) !important;
        }

        /* MAIN AREA */
        .main-area {
            margin-left: 255px;
            min-height: 100vh;
        }

        .topbar {
            min-height: 82px;
            padding: 18px 38px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            background: rgba(19,11,32,0.7);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }

        .breadcrumb {
            color: #927da7;
            font-size: 12px;
        }

        .breadcrumb span {
            color: #ff70c5;
            font-weight: 700;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            font-size: 20px;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 800;
        }

        .profile-role {
            color: #a18cad;
            font-size: 10px;
            margin-top: 4px;
        }

        /* CONTENT */
        .main {
            padding: 38px;
            max-width: 1600px;
            margin: auto;
        }

        .welcome-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 35px;
        }

        .welcome-tag {
            color: #ff70c5;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2.5px;
            margin-bottom: 13px;
        }

        .welcome-section h1 {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(28px, 3vw, 39px);
            font-weight: 900;
            letter-spacing: -1.2px;
            margin-bottom: 10px;
        }

        .welcome-section h1 span {
            background: linear-gradient(90deg, var(--pink), #c4b5fd);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .year-badge {
            padding: 12px 16px;
            background: rgba(255,60,172,0.08);
            border: 1px solid rgba(255,60,172,0.2);
            color: #ff9bd5;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        /* ORGANIZATION SECTION */
        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .section-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 22px;
            font-weight: 800;
        }

        .section-heading p {
            color: #a18cad;
            font-size: 11px;
            margin-top: 6px;
        }

        .section-label {
            color: #ff70c5;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .org-container {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .org-card {
            padding: 24px;
            background: linear-gradient(145deg,
                rgba(42,27,59,0.96),
                rgba(29,17,43,0.96));
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.3s;
            position: relative;
            overflow: hidden;
        }

        .org-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,60,172,0.35);
            box-shadow: 0 12px 35px rgba(0,0,0,0.2);
        }

        .org-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--pink), var(--purple));
            opacity: 0;
            transition: 0.3s;
        }

        .org-card:hover::before {
            opacity: 1;
        }

        .org-header {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 22px;
        }

        .org-identity {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .org-icon {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            font-size: 24px;
            background: rgba(255,60,172,0.12);
            border: 1px solid rgba(255,60,172,0.16);
        }

        .org-name {
            font-family: 'Outfit', sans-serif;
            font-size: 16px;
            font-weight: 800;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .org-type {
            color: #a18cad;
            font-size: 11px;
            margin-top: 6px;
        }

        .org-divider {
            height: 1px;
            background: var(--border);
            margin-bottom: 18px;
        }

        .org-description {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .org-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .org-year {
            color: #a18cad;
            font-size: 11px;
        }

        .view-btn {
            display: inline-block;
            padding: 10px 15px;
            color: white;
            background: linear-gradient(100deg, var(--pink), var(--purple));
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
            transition: 0.25s;
            white-space: nowrap;
        }

        .view-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 18px rgba(255,60,172,0.25);
        }

        footer {
            color: #806b95;
            text-align: center;
            font-size: 11px;
            margin-top: 40px;
            padding-bottom: 10px;
        }

        /* RESPONSIVE */
        @media (max-width: 1100px) {
            .org-container {
                grid-template-columns: 1fr;
            }

            .main {
                padding: 28px;
            }

            .topbar {
                padding: 18px 28px;
            }
        }

        @media (max-width: 760px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 18px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu-label,
            .sidebar-tip {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .sidebar nav a {
                margin: 0;
                flex: 1 1 140px;
            }

            .sidebar-bottom {
                margin-top: 10px;
            }

            .main-area {
                margin-left: 0;
            }

            .topbar {
                padding: 16px 20px;
            }

            .main {
                padding: 25px 18px;
            }

            .welcome-section {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .profile-name,
            .profile-role {
                display: none;
            }

            .org-card {
                padding: 18px;
            }

            .org-footer {
                align-items: flex-start;
                flex-direction: column;
            }

            .year-badge {
                white-space: normal;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="logo">
            <div class="logo-icon">✦</div>
            <div>
                <div class="logo-text">ORG<span>PORT</span></div>
                <div class="logo-subtitle">ORGANIZATION PORTAL</div>
            </div>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <nav>
            <a href="/dashboard?email=<%= encodeURIComponent(email) %>">
                <span>⌂</span>Dashboard
            </a>
            
            <a href="/renewal?email=<%= encodeURIComponent(email) %>">
                <span>✧</span>Organization Renewal
            </a>
            
            <a href="/status?email=<%= encodeURIComponent(email) %>">
                <span>◷</span>Renewal Status
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-tip">
                <div class="tip-icon">💖</div>
                <h4>You've got this!</h4>
                <p>Keep your organization information updated and your renewal documents ready.</p>
            </div>

            <a href="/logout" class="logout">
                <span class="nav-icon">↪</span>
                Log Out
            </a>
        </div>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <div class="breadcrumb">
                Pages / <span>Dashboard</span>
            </div>

            <div class="profile">
                <div class="profile-avatar">👑</div>
                <div>
                    <div class="profile-name">Organization Member</div>
                    <div class="profile-role">Portal Account</div>
                </div>
            </div>
        </header>

        <main class="main">

            <section class="welcome-section">
                <div>
                    <div class="welcome-tag">✦ YOUR ORGANIZATION SPACE</div>
                    <h1>Welcome to <span>OrgPort!</span></h1>
                    <p class="subtitle">
                        Manage your organization and keep your renewal requirements on track.
                    </p>
                </div>

                <div class="year-badge">
                    ✦ SCHOOL YEAR 2026–2027
                </div>
            </section>

            <section class="organizations">
                <div class="section-heading">
                    <div>
                        <h2>Your Organizations</h2>
                        <p>Explore your organizations and their renewal information.</p>
                    </div>

                    <div class="section-label">ORGANIZATION LIST</div>
                </div>

                <div class="org-container">

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">✦</div>
                                <div>
                                    <div class="org-name">XCite</div>
                                    <div class="org-type">Dance Organization</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            View XCite's organization details and review the requirements
                            for the current school year's renewal.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/xcite?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">♛</div>
                                <div>
                                    <div class="org-name">Cite Student Council</div>
                                    <div class="org-type">Leadership</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            Explore the Student Council's organization details and
                            its renewal requirements.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/cite-student-council?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">⌘</div>
                                <div>
                                    <div class="org-name">CITE Multimedia Arts Studio</div>
                                    <div class="org-type">Multimedia Arts</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            Check the Multimedia Arts Studio's details and prepare
                            the required renewal documents.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/cite-multimedia-arts-studio?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                    <article class="org-card">
                        <div class="org-header">
                            <div class="org-identity">
                                <div class="org-icon">⌨</div>
                                <div>
                                    <div class="org-name">F1 Stack Mind</div>
                                    <div class="org-type">Technology</div>
                                </div>
                            </div>
                        </div>

                        <div class="org-divider"></div>

                        <p class="org-description">
                            View F1 Stack Mind's organization information and
                            review its renewal requirements.
                        </p>

                        <div class="org-footer">
                            <span class="org-year">School Year 2026–2027</span>
                            <a href="/organization/f1?email=<%= encodeURIComponent(email) %>"  class="view-btn">
                                View Details →
                            </a>
                        </div>
                    </article>

                </div>
            </section>

            <footer>
                © 2026 OrgPort · Lead boldly. Renew confidently.
            </footer>

        </main>
    </div>

</body>
</html>
