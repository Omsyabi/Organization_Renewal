<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OrgPort | XCite Details</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }

        :root {
            --pink: #ff3cac;
            --hot-pink: #ff1493;
            --purple: #a855f7;
            --dark: #130b20;
            --panel: #20132e;
            --muted: #b8a8c9;
            --white: #fff8ff;
            --border: rgba(255,255,255,0.09);
        }

        body {
            min-height: 100vh;
            background: var(--dark);
            color: var(--white);
            padding: 35px 20px;
            position: relative;
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.2;
            z-index: -1;
            pointer-events: none;
        }

        body::before {
            background: var(--pink);
            top: -150px;
            right: -50px;
        }

        body::after {
            background: var(--purple);
            bottom: -150px;
            left: -50px;
        }

        .container {
            width: 100%;
            max-width: 900px;
            margin: auto;
        }

        /* TOP NAVIGATION */

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            box-shadow: 0 0 22px rgba(255,60,172,0.25);
            font-size: 22px;
        }

        .brand-name {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            font-size: 20px;
        }

        .brand-name span {
            color: #ff70c5;
        }

        .back-link {
            color: #ff85cc;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
            padding: 12px 17px;
            border: 1px solid rgba(255,60,172,0.25);
            background: rgba(255,60,172,0.07);
            border-radius: 10px;
            transition: 0.25s;
        }

        .back-link:hover {
            background: rgba(255,60,172,0.16);
            transform: translateY(-2px);
        }

        /* HERO */

        .hero {
            position: relative;
            overflow: hidden;
            padding: 40px;
            border-radius: 22px;
            background:
                radial-gradient(circle at 85% 20%, rgba(255,60,172,0.2), transparent 35%),
                linear-gradient(135deg, #2a173b, #1b1029);
            border: 1px solid rgba(255,60,172,0.2);
            box-shadow: 0 15px 50px rgba(0,0,0,0.2);
            margin-bottom: 25px;
        }

        .hero::after {
            content: "✦";
            position: absolute;
            right: 30px;
            bottom: -65px;
            font-size: 230px;
            color: rgba(255,60,172,0.06);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .eyebrow {
            display: inline-block;
            padding: 8px 13px;
            background: rgba(255,60,172,0.1);
            border: 1px solid rgba(255,60,172,0.3);
            border-radius: 30px;
            color: #ff85cc;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        .hero-title {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .org-logo {
            width: 75px;
            height: 75px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 22px;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            box-shadow: 0 0 30px rgba(255,60,172,0.25);
            font-size: 37px;
        }

        h1 {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(34px, 6vw, 48px);
            font-weight: 900;
            letter-spacing: -1.5px;
        }

        .gradient-text {
            background: linear-gradient(90deg, #ff3cac, #c4b5fd);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-description {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
            max-width: 550px;
        }

        .hero-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 25px;
        }

        .tag {
            padding: 9px 13px;
            border-radius: 9px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            color: #e3d4f0;
            font-size: 11px;
            font-weight: 600;
        }

        /* CONTENT GRID */

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 22px;
        }

        .card {
            padding: 27px;
            background: rgba(32,19,46,0.92);
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.25s ease;
        }

        .card:hover {
            border-color: rgba(255,60,172,0.25);
            box-shadow: 0 10px 35px rgba(0,0,0,0.15);
        }

        .card-heading {
            display: flex;
            align-items: center;
            gap: 13px;
            margin-bottom: 25px;
        }

        .heading-icon {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 13px;
            background: rgba(255,60,172,0.12);
            border: 1px solid rgba(255,60,172,0.16);
            font-size: 20px;
        }

        .card-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 19px;
            font-weight: 800;
        }

        .card-heading p {
            color: #9885aa;
            font-size: 11px;
            margin-top: 4px;
        }

        /* DETAILS */

        .info {
            padding: 16px;
            margin-bottom: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px;
            background: rgba(255,255,255,0.025);
        }

        .info:last-child {
            margin-bottom: 0;
        }

        .info-label {
            display: block;
            color: #a18cad;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .info-value {
            color: #fff4ff;
            font-size: 13px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .year-value {
            color: #ff80cb;
        }

        /* REQUIREMENTS */

        .requirements {
            list-style: none;
        }

        .requirements li {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            color: #e5d8ef;
            font-size: 12px;
            line-height: 1.7;
        }

        .requirements li:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .check-icon {
            flex-shrink: 0;
            width: 23px;
            height: 23px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 8px;
            background: rgba(255,60,172,0.12);
            color: #ff80cb;
            font-size: 12px;
            font-weight: 800;
        }

        /* REMINDER */

        .reminder {
            margin-top: 22px;
            padding: 24px;
            display: flex;
            align-items: flex-start;
            gap: 15px;
            background: linear-gradient(
                100deg,
                rgba(255,60,172,0.1),
                rgba(139,92,246,0.1)
            );
            border: 1px solid rgba(255,60,172,0.2);
            border-radius: 16px;
        }

        .reminder-icon {
            width: 42px;
            height: 42px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: rgba(255,60,172,0.15);
            font-size: 21px;
        }

        .reminder h3 {
            font-family: 'Outfit', sans-serif;
            font-size: 15px;
            margin-bottom: 8px;
        }

        .reminder p {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.8;
        }

        /* ACTIONS */

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 25px;
        }

        .btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 9px;
            padding: 14px 22px;
            border-radius: 11px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            transition: 0.25s ease;
        }

        .btn-primary {
            color: white;
            background: linear-gradient(100deg, #ff1493, #a855f7);
            box-shadow: 0 7px 24px rgba(255,20,147,0.2);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(255,20,147,0.35);
        }

        .btn-secondary {
            color: #ff85cc;
            background: rgba(255,60,172,0.06);
            border: 1px solid rgba(255,60,172,0.23);
        }

        .btn-secondary:hover {
            background: rgba(255,60,172,0.14);
            transform: translateY(-2px);
        }

        /* FOOTER */

        footer {
            text-align: center;
            padding: 35px 10px 10px;
            color: #796987;
            font-size: 10px;
            letter-spacing: 0.5px;
        }

        /* RESPONSIVE */

        @media (max-width: 700px) {
            body {
                padding: 22px 15px;
            }

            .hero {
                padding: 28px 22px;
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 22px;
            }

            .org-logo {
                width: 62px;
                height: 62px;
                font-size: 30px;
                border-radius: 18px;
            }

            .hero-title {
                gap: 15px;
            }

            .hero-title h1 {
                font-size: 36px;
            }

            .reminder {
                padding: 20px;
            }
        }

        @media (max-width: 400px) {
            .brand-name {
                font-size: 17px;
            }

            .back-link {
                padding: 10px;
                font-size: 11px;
            }

            .hero-title h1 {
                font-size: 31px;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- TOP NAVIGATION -->

        <header class="topbar">

            <div class="brand">
                <div class="brand-icon">✦</div>

                <div class="brand-name">
                    ORG<span>PORT</span>
                </div>
            </div>

            <a href="/dashboard?email=<%= encodeURIComponent(email || '') %>"
                class="btn btn-secondary">
                 ← Back to Dashboard
             </a>

        </header>

        <!-- HERO SECTION -->

        <section class="hero">

            <div class="hero-content">

                <div class="eyebrow">
                    ✦ ORGANIZATION PROFILE
                </div>

                <div class="hero-title">

                    <div class="org-logo">💃</div>

                    <h1>
                        <span class="gradient-text">XCite</span>
                    </h1>

                </div>

                <p class="hero-description">
                    Welcome to the XCite organization profile.
                    Review your organization information, prepare your
                    renewal requirements, and stay ready for the
                    upcoming school year.
                </p>

                <div class="hero-tags">
                    <span class="tag">💃 Dance School</span>
                    <span class="tag">📅 School Year 2026–2027</span>
                    <span class="tag">✦ OrgPort</span>
                </div>

            </div>

        </section>

        <!-- MAIN CONTENT -->

        <div class="content-grid">

            <!-- ORGANIZATION DETAILS -->

            <section class="card">

                <div class="card-heading">

                    <div class="heading-icon">✧</div>

                    <div>
                        <h2>Organization Details</h2>
                        <p>Your organization's basic information</p>
                    </div>

                </div>

                <div class="info">
                    <span class="info-label">About the Organization</span>
                    <div class="info-value">XCite is a dance-based organization under the Information
                        Technology (IT) Department that promotes dance, creativity,
                        teamwork, and student talent.</div>
                </div>

                <div class="info">
                    <span class="info-label">Category</span>
                    <div class="info-value">Dance Organization</div>
                </div>

                <div class="info">
                    <span class="info-label">School Year</span>
                    <div class="info-value year-value">2026–2027</div>
                </div>

            </section>

            <!-- RENEWAL REQUIREMENTS -->

            <section class="card">

                <div class="card-heading">

                    <div class="heading-icon">📋</div>

                    <div>
                        <h2>Renewal Requirements</h2>
                        <p>Documents to prepare for submission</p>
                    </div>

                </div>

                
<ul class="requirements">

    <li>
        <span class="check-icon">01</span>
        <span>Fill out the organization renewal form</span>
    </li>

    <li>
        <span class="check-icon">02</span>
        <span>Submit your application for review</span>
    </li>

    <li>
        <span class="check-icon">03</span>
        <span>Wait for the administrator to review your application</span>
    </li>

    <li>
        <span class="check-icon">04</span>
        <span>Check your renewal status for approval or rejection</span>
    </li>

</ul>

            </section>

        </div>

        <!-- REMINDER -->

        <section class="reminder">

            <div class="reminder-icon">💌</div>

            <div>
                <h3>Keep that renewal on track, boss!</h3>

                <p>
                    Head to the renewal form to begin your application.
                    Prepare all required documents and check your application
                    status regularly for updates.
                </p>
            </div>

        </section>

        <!-- ACTION BUTTONS -->
<div class="actions">

    <a href="/renewal?email=<%= encodeURIComponent(email || '') %>"
        class="btn btn-primary">
         📑 Go to Renewal Form →
     </a>
     
     <a href="/status?email=<%= encodeURIComponent(email || '') %>"
        class="btn btn-secondary">
         📋 Check Application Status
     </a>
     
     <a href="/dashboard?email=<%= encodeURIComponent(email || '') %>"
        class="btn btn-secondary">
         ← Back to Dashboard
     </a>
</div>

        <footer>
            © 2026 ORGPORT · BUILT FOR THE BOLD ✦
        </footer>

    </div>

</body>
</html>