
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OrgPort | Renewal Status</title>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'DM Sans', sans-serif;
        }

        :root {
            --pink: #ff3cac;
            --purple: #a855f7;
            --dark: #130b20;
            --panel: #20132e;
            --border: rgba(255,255,255,0.09);
            --muted: #b8a8c9;
            --white: #fff8ff;
        }

        body {
            background: var(--dark);
            color: var(--white);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.2;
            pointer-events: none;
            z-index: -1;
        }

        body::before {
            background: var(--pink);
            top: -150px;
            right: 10%;
        }

        body::after {
            background: var(--purple);
            bottom: -150px;
            left: 20%;
        }

        /* SIDEBAR */
        .sidebar {
            width: 255px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 28px 18px;
            background: rgba(25,14,37,0.96);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            z-index: 100;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 5px 8px;
            margin-bottom: 45px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            box-shadow: 0 0 22px rgba(255,60,172,0.25);
            font-size: 23px;
        }

        .logo-text {
            font-family: 'Outfit', sans-serif;
            font-size: 21px;
            font-weight: 900;
        }

        .logo-text span {
            color: #ff70c5;
        }

        .logo-subtitle {
            color: #9582a9;
            font-size: 10px;
            margin-top: 3px;
            letter-spacing: 1px;
        }

        .menu-label {
            color: #806b95;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            padding: 0 13px;
            margin-bottom: 15px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 14px 15px;
            margin-bottom: 8px;
            color: var(--muted);
            text-decoration: none;
            border: 1px solid transparent;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.25s;
        }

        .nav-icon {
            width: 23px;
            text-align: center;
            font-size: 17px;
        }

        .sidebar a:hover {
            color: white;
            background: rgba(255,60,172,0.08);
            border-color: rgba(255,60,172,0.15);
            transform: translateX(3px);
        }

        .sidebar a.active {
            color: white;
            background: linear-gradient(
                100deg,
                rgba(255,60,172,0.19),
                rgba(139,92,246,0.12)
            );
            border-color: rgba(255,60,172,0.3);
            box-shadow: inset 3px 0 var(--pink);
        }

        .sidebar-bottom {
            margin-top: auto;
        }

        .sidebar-tip {
            background: linear-gradient(
                135deg,
                rgba(255,60,172,0.12),
                rgba(139,92,246,0.12)
            );
            border: 1px solid rgba(255,60,172,0.17);
            border-radius: 15px;
            padding: 17px;
            margin-bottom: 20px;
        }

        .tip-icon {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .sidebar-tip h4 {
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .sidebar-tip p {
            color: var(--muted);
            font-size: 11px;
            line-height: 1.7;
        }

        .logout {
            color: #ff82bd !important;
            border: 1px solid rgba(255,60,172,0.15) !important;
        }

        .logout:hover {
            background: rgba(255,60,172,0.12) !important;
        }

        /* MAIN AREA */
        .main-area {
            margin-left: 255px;
            min-height: 100vh;
        }

        .topbar {
            min-height: 82px;
            padding: 18px 38px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            background: rgba(19,11,32,0.7);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(20px);
        }

        .breadcrumb {
            color: #927da7;
            font-size: 12px;
        }

        .breadcrumb span {
            color: #ff70c5;
            font-weight: 700;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-avatar {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--pink), var(--purple));
            font-size: 20px;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 800;
        }

        .profile-role {
            color: #a18cad;
            font-size: 10px;
            margin-top: 4px;
        }

        /* PAGE CONTENT */
        .main {
            padding: 32px;
            max-width: 1600px;
            margin: auto;
        }

        .welcome-tag {
            color: #ff70c5;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2.5px;
            margin-bottom: 12px;
        }

        h1 {
            font-family: 'Outfit', sans-serif;
            font-size: clamp(27px, 3vw, 36px);
            font-weight: 900;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        h1 span {
            background: linear-gradient(90deg, var(--pink), #c4b5fd);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .subtitle {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        /* STATUS GROUPS */
        .status-group {
            margin-bottom: 30px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .section-heading h2 {
            font-family: 'Outfit', sans-serif;
            font-size: 20px;
            font-weight: 800;
        }

        .section-heading p {
            color: #a18cad;
            font-size: 11px;
            margin-top: 5px;
            line-height: 1.6;
        }

        .section-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 30px;
            height: 30px;
            padding: 0 9px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 800;
        }

        .pending-count {
            color: #ffdc80;
            background: rgba(255,205,90,0.12);
            border: 1px solid rgba(255,205,90,0.25);
        }

        .approved-count {
            color: #8af0bd;
            background: rgba(80,220,150,0.12);
            border: 1px solid rgba(80,220,150,0.25);
        }

        .rejected-count {
            color: #ff9bad;
            background: rgba(255,100,130,0.12);
            border: 1px solid rgba(255,100,130,0.25);
        }

        /* APPLICATION GRID */
        .application-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        /* APPLICATION CARDS */
        .renewal-card {
            background: linear-gradient(
                145deg,
                rgba(42,27,59,0.96),
                rgba(29,17,43,0.96)
            );
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            min-width: 0;
            position: relative;
            overflow: hidden;
            transition: 0.25s;
        }

        .renewal-card:hover {
            transform: translateY(-3px);
            border-color: rgba(255,60,172,0.35);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        .renewal-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--pink), var(--purple));
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .card-header h3 {
            font-family: 'Outfit', sans-serif;
            font-size: 16px;
            margin-bottom: 5px;
            overflow-wrap: anywhere;
        }

        .submitted-date {
            color: #a18cad;
            font-size: 10px;
            line-height: 1.6;
        }

        .status {
            display: inline-block;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 800;
            white-space: nowrap;
        }

        .Pending {
            background: rgba(255,205,90,0.13);
            border: 1px solid rgba(255,205,90,0.25);
            color: #ffdc80;
        }

        .Approved {
            background: rgba(80,220,150,0.12);
            border: 1px solid rgba(80,220,150,0.25);
            color: #8af0bd;
        }

        .Rejected {
            background: rgba(255,100,130,0.12);
            border: 1px solid rgba(255,100,130,0.25);
            color: #ff9bad;
        }

        .divider {
            height: 1px;
            background: var(--border);
            margin: 12px 0;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .detail-label {
            color: #a18cad;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 4px;
        }

        .detail-value {
            color: #eee3f6;
            font-size: 11px;
            line-height: 1.6;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
        }

        .remarks-box {
            margin-top: 14px;
            padding: 12px;
            background: rgba(255,60,172,0.06);
            border: 1px solid rgba(255,60,172,0.13);
            border-radius: 10px;
        }

        .empty-small {
            padding: 16px;
            background: rgba(32,19,46,0.8);
            border: 1px dashed rgba(255,255,255,0.12);
            border-radius: 10px;
            color: #a18cad;
            font-size: 11px;
            text-align: center;
        }

        .empty {
            text-align: center;
            padding: 45px 20px;
            background: linear-gradient(
                145deg,
                rgba(42,27,59,0.96),
                rgba(29,17,43,0.96)
            );
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .empty-icon {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .empty h3 {
            font-family: 'Outfit', sans-serif;
            font-size: 19px;
            margin-bottom: 10px;
        }

        .empty p {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .action-btn {
            display: inline-block;
            padding: 11px 17px;
            color: white;
            background: linear-gradient(100deg, var(--pink), var(--purple));
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            text-decoration: none;
            transition: 0.25s;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 18px rgba(255,60,172,0.25);
        }

        footer {
            color: #806b95;
            text-align: center;
            font-size: 11px;
            margin-top: 35px;
            padding-bottom: 10px;
        }

        /* RESPONSIVE */
        @media (max-width: 1100px) {
            .main {
                padding: 25px;
            }

            .topbar {
                padding: 18px 25px;
            }
        }

        @media (max-width: 900px) {
            .application-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 760px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 18px;
            }

            .logo {
                margin-bottom: 20px;
            }

            .menu-label,
            .sidebar-tip {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .sidebar nav a {
                margin: 0;
                flex: 1 1 140px;
            }

            .sidebar-bottom {
                margin-top: 10px;
            }

            .main-area {
                margin-left: 0;
            }

            .topbar {
                padding: 16px 20px;
            }

            .main {
                padding: 22px 18px;
            }
        }
        
            .delete-btn {
                padding: 10px 15px;
                background: rgba(255, 70, 100, 0.12);
                color: #ff9bad;
                border: 1px solid rgba(255, 100, 130, 0.3);
                border-radius: 9px;
                font-size: 11px;
                font-weight: 800;
                cursor: pointer;
                transition: 0.25s;
            }

            .delete-btn:hover {
                background: #ff4664;
                color: white;
            }


        @media (max-width: 480px) {
            .profile-name,
            .profile-role {
                display: none;
            }

            .renewal-card {
                padding: 16px;
            }

            .card-header {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="logo">
            <div class="logo-icon">✦</div>
            <div>
                <div class="logo-text">ORG<span>PORT</span></div>
                <div class="logo-subtitle">ORGANIZATION PORTAL</div>
            </div>
        </div>

        <div class="menu-label">MAIN MENU</div>

        <nav>
            <a href="/dashboard?email=<%= encodeURIComponent(email) %>">
                <span class="nav-icon">⌂</span>
                Dashboard
            </a>

            <a href="/renewal?email=<%= encodeURIComponent(email) %>">
                <span class="nav-icon">✧</span>
                Organization Renewal
            </a>

            <a href="/status?email=<%= encodeURIComponent(email) %>" class="active">
                <span class="nav-icon">◷</span>
                Renewal Status
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-tip">
                <div class="tip-icon">💖</div>
                <h4>Stay Updated!</h4>
                <p>
                    Check your renewal status regularly for updates and
                    remarks from the administrator.
                </p>
            </div>

            <a href="/logout" class="logout">
                <span class="nav-icon">↪</span>
                Log Out
            </a>
        </div>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <div class="breadcrumb">
                Pages / <span>Renewal Status</span>
            </div>

            <div class="profile">
                <div class="profile-avatar">👑</div>
                <div>
                    <div class="profile-name">Organization Member</div>
                    <div class="profile-role">Portal Account</div>
                </div>
            </div>
        </header>

        <main class="main">

            <div class="welcome-tag">✦ APPLICATION TRACKER</div>

            <h1>Your Renewal <span>Status</span></h1>

            <p class="subtitle">
                Track your organization's renewal applications and view
                updates from the administrator.
            </p>

            <%
                const allRenewals = renewals || [];

                const statusGroups = [
                    {
                        name: 'Pending',
                        description: 'Applications waiting for administrator review.',
                        icon: '◷',
                        countClass: 'pending-count',
                        items: allRenewals.filter(item => item.status === 'Pending')
                    },
                    {
                        name: 'Approved',
                        description: 'Applications approved by the administrator.',
                        icon: '✓',
                        countClass: 'approved-count',
                        items: allRenewals.filter(item => item.status === 'Approved')
                    },
                    {
                        name: 'Rejected',
                        description: 'Applications that were not approved.',
                        icon: '✕',
                        countClass: 'rejected-count',
                        items: allRenewals.filter(item => item.status === 'Rejected')
                    }
                ];
            %>

            <% if (allRenewals.length === 0) { %>

                <div class="empty">
                    <div class="empty-icon">📄</div>
                    <h3>No Renewal Applications Yet</h3>

                    <p>
                        You haven't submitted an organization renewal application.
                        Submit your form to track its progress here.
                    </p>

                    <a
                        href="/renewal?email=<%= encodeURIComponent(email) %>"
                        class="action-btn">
                        Submit Renewal →
                    </a>
                </div>

            <% } else { %>

                <% statusGroups.forEach(function(group) { %>

                    <section class="status-group">

                        <div class="section-heading">
                            <div>
                                <h2><%= group.icon %> <%= group.name %></h2>
                                <p><%= group.description %></p>
                            </div>

                            <span class="section-count <%= group.countClass %>">
                                <%= group.items.length %>
                            </span>
                        </div>

                        <% if (group.items.length > 0) { %>

                            <div class="application-grid">

                                <% group.items.forEach(function(item) { %>

                                    <article class="renewal-card">

                                        <div class="card-header">
                                            <div>
                                                <h3><%= item.org_name %></h3>

                                                <p class="submitted-date">
                                                    Submitted:
                                                    <%= item.submitted_at
                                                        ? new Date(item.submitted_at).toLocaleString()
                                                        : 'Not available' %>
                                                </p>
                                            </div>

                                            <span class="status <%= item.status %>">
                                                <%= item.status %>
                                            </span>
                                        </div>

                                        <div class="divider"></div>

                                        <div class="details-grid">

                                            <div>
                                                <div class="detail-label">Applicant Name</div>
                                                <div class="detail-value"><%= item.fullname %></div>
                                            </div>

                                            <div>
                                                <div class="detail-label">School Year</div>
                                                <div class="detail-value"><%= item.school_year %></div>
                                            </div>

                                            <div>
                                                <div class="detail-label">Organization Type</div>
                                                <div class="detail-value"><%= item.org_type %></div>
                                            </div>

                                            <div>
                                                <div class="detail-label">Objectives</div>
                                                <div class="detail-value">
                                                    <%= item.objectives || 'No objectives provided.' %>
                                                </div>
                                            </div>

                                            <div>
                                                <div class="detail-label">Achievements</div>
                                                <div class="detail-value">
                                                    <%= item.achievements || 'No achievements provided.' %>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="remarks-box">
                                            <div class="detail-label">
                                                Administrator Remarks
                                            </div>

                                            <div class="detail-value">
                                                <%= item.admin_remarks || 'No remarks yet.' %>
                                            </div>
                                        </div>

                                        
                                        <% if (item.status === 'Pending') { %>
                                            <form action="/delete/<%= item.renewal_id %>" method="POST"
                                                  onsubmit="return confirm('Delete this renewal application?');">
                                        
                                                <input type="hidden" name="email" value="<%= email %>">
                                        
                                                <button type="submit" class="delete-btn">
                                                    Delete Renewal
                                                </button>
                                            </form>
                                        <% } %>

                                    </article>

                                <% }); %>

                            </div>

                        <% } else { %>

                            <div class="empty-small">
                                No <%= group.name.toLowerCase() %> applications.
                            </div>

                        <% } %>

                    </section>

                <% }); %>

            <% } %>

            <footer>
                © 2026 OrgPort · Lead boldly. Renew confidently.
            </footer>

        </main>
    </div>

</body>
</html>
